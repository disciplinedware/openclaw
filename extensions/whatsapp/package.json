{
  "name": "@disciplinedware/whatsapp-for-business",
  "version": "2026.10.8-1",
  "description": "OpenClaw WhatsApp channel plugin, built from the disciplinedware OpenClaw fork: own messages as history and owner turns, and native approvals that only execApprovals approvers or command owners resolve.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "audio-decode": "3.12.0",
    "baileys": "7.0.0-rc14",
    "typebox": "1.3.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.8"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "setupFeatures": {
      "configPromotion": "preserve-root",
      "legacySessionSurfaces": true
    },
    "channel": {
      "id": "whatsapp",
      "approvalFlags": [
        "native"
      ],
      "label": "WhatsApp",
      "selectionLabel": "WhatsApp (QR link)",
      "detailLabel": "WhatsApp Web",
      "docsPath": "/channels/whatsapp",
      "docsLabel": "whatsapp",
      "blurb": "works with your own number; recommend a separate phone + eSIM.",
      "systemImage": "message",
      "persistedAuthState": {
        "specifier": "./auth-presence",
        "exportName": "hasAnyWhatsAppAuth"
      },
      "setup": {
        "fields": [
          {
            "key": "authDir",
            "kind": "string",
            "cli": {
              "flags": "--auth-dir <path>",
              "description": "WhatsApp auth directory override"
            }
          }
        ]
      }
    },
    "install": {
      "npmSpec": "@disciplinedware/whatsapp-for-business",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.10.8"
    },
    "build": {
      "bundledDist": false,
      "openclawVersion": "2026.10.8"
    },
    "release": {
      "publishToClawHub": false,
      "publishToNpm": false
    }
  }
}
